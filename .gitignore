# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Global IDE and System files
.vscode/
.claude/
.DS_Store
*.pem

# Dependencies (Catches both root, frontend, and backend)
**/node_modules/

# Expo & Web builds
**/.expo/
**/dist/
**/web-build/
**/expo-env.d.ts

# Native
**/.kotlin/
**/*.orig.*
**/*.jks
**/*.p8
**/*.p12
**/*.key
**/*.mobileprovision

# Metro
**/.metro-health-check*

# Debug logs
**/npm-debug.*
**/yarn-debug.*
**/yarn-error.*

# Local environment files (Crucial for API keys)
.env
.env*.local
**/.env

# TypeScript build info
**/*.tsbuildinfo

# Generated native folders
**/ios/
**/android/
